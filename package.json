{
  "name": "shuttlehub-tournament-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "build:cloud": "vite build --mode cloud",
    "dev:cloud": "npm run build:cloud && wrangler dev --local",
    "deploy:cloud": "npm run build:cloud && wrangler deploy",
    "test:cloud": "node --test tests/cloud/*.test.js",
    "test:browser": "playwright test",
    "test:load": "node scripts/load-cloud.mjs",
    "test:runtime": "node scripts/runtime-check.mjs",
    "provision": "node scripts/provision.mjs",
    "backup:local": "node scripts/backup-local.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.151.3",
    "ws": "^8.22.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
