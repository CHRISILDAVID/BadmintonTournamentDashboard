{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttlehub",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [
    { "name": "DIRECTORY", "class_name": "OwnerDirectory" },
    { "name": "EVENTS", "class_name": "TournamentEvent" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerDirectory", "TournamentEvent"] }],
  "observability": { "enabled": false }
}
